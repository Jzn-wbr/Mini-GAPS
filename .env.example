# Copier vers .env : seul fichier de configuration à renseigner, hors Git.
# Permissions : chmod 600 .env
# Développement : origine HTTP locale et diagnostics. Serveur : DEV=false.
DEV=true
# DEV=true : origine locale par défaut si APP_ORIGIN est vide.
# DEV=false : renseigner obligatoirement une origine HTTPS, sans slash final.
# Exemple fictif : APP_ORIGIN=https://mini-gaps.example.org
APP_ORIGIN=
LOCAL_UID=1000
LOCAL_GID=1000

# Garder les guillemets simples pour préserver les caractères $ et #.
# Échapper une apostrophe avec \' et un antislash avec \\.
GAPS_USERNAME=''
GAPS_PASSWORD=''

# Les données SQLite et clés Push générées sont conservées dans data/.
# Seul le scraper reçoit le fichier .env complet, monté en lecture seule.
